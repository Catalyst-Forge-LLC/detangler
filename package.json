{
	"name": "detangler",
	"version": "0.1.4",
	"private": false,
	"type": "module",
	"description": "Find what the editing tangled. Structural pass for drafts and programs that have been worked over. Combs the whole draft or the whole program, not single strands.",
	"license": "MIT",
	"author": "Catalyst Forge LLC",
	"keywords": [
		"writing",
		"editing",
		"outline",
		"structure",
		"markdown",
		"llm",
		"prose",
		"skill",
		"apps"
	],
	"homepage": "https://detangler.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Catalyst-Forge-LLC/detangler.git"
	},
	"bugs": {
		"url": "https://github.com/Catalyst-Forge-LLC/detangler/issues"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./skills/*": "./skills/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/index.js",
		"dist/index.d.ts",
		"skills",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"test": "tsc && node --test dist/index.test.js",
		"prepare": "tsc",
		"prepublishOnly": "tsc && pnpm test",
		"ship": "pnpm --dir site run ship",
		"site:dev": "pnpm --dir site dev",
		"site:build": "pnpm --dir site run build",
		"site:deploy": "pnpm --dir site run ship"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.30.1",
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.9.2"
	}
}
